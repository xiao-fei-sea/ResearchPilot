# 复制为 .env 后按需修改；所有键均可直接用环境变量覆盖

# --- 基础 ---
APP_ENVIRONMENT=dev
# JSON 数组格式
CORS_ORIGINS=["http://localhost:5173"]

# --- 数据层 ---
DATABASE_URL=mysql+pymysql://researchpilot:researchpilot@localhost:3306/researchpilot?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0

# --- LLM（OpenAI 兼容）---
LLM_BASE_URL=
LLM_API_KEY=
LLM_STRONG_MODEL=
LLM_SMALL_MODEL=

# --- 搜索 ---
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
SEARXNG_BASE_URL=

# --- 预算 ---
MAX_SOURCES=60
MAX_ROUNDS=2
TASK_TIME_LIMIT=900

# --- P0 冒烟开关（M1 接入真实流水线后置 false）---
MOCK_PIPELINE=true
